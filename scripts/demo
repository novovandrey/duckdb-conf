#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
JAR_PATH="${ROOT_DIR}/app-runner/target/app-runner-1.0-SNAPSHOT.jar"

alias_name="${1:-}"
if [[ -z "${alias_name}" ]]; then
  echo "Usage: scripts/demo <alias>"
  exit 1
fi

require_env() {
  local name="$1"
  if [[ -z "${!name:-}" ]]; then
    echo "Missing required environment variable: ${name}" >&2
    exit 2
  fi
}

pick_parquet() {
  if [[ "${DUCKDB_DEMO_FAST:-false}" == "true" ]]; then
    require_env "DUCKDB_DEMO_PPD_PARQUET_SMALL"
    echo "${DUCKDB_DEMO_PPD_PARQUET_SMALL}"
    return
  fi
  if [[ -n "${DUCKDB_DEMO_PPD_PARQUET_FULL:-}" ]]; then
    echo "${DUCKDB_DEMO_PPD_PARQUET_FULL}"
    return
  fi
  require_env "DUCKDB_DEMO_PPD_PARQUET"
  echo "${DUCKDB_DEMO_PPD_PARQUET}"
}

PPD_PARQUET="$(pick_parquet)"
require_env "DUCKDB_DEMO_DISTRICT_CSV"

run_java() {
  java -jar "${JAR_PATH}" "$@"
}

case "${alias_name}" in
  01-parquet-scan)
    run_java --demo --engine duckdb --dataset ppd --case ppd_median_by_district --file "${PPD_PARQUET}" --threads 8 --warmup 0 --runs 1
    ;;
  02-duckdb-vs-parquet-java)
    run_java --demo --engine both --dataset ppd --case ppd_new_vs_old --file "${PPD_PARQUET}" --threads 8 --warmup 0 --runs 1
    ;;
  03-cross-source-join)
    run_java --demo --engine duckdb --dataset ppd --case cross_source_join --file "${PPD_PARQUET}" --threads 8 --warmup 0 --runs 1
    ;;
  04-threads)
    run_java --demo --engine duckdb --dataset ppd --case ppd_sales_by_year --file "${PPD_PARQUET}" --threads 1 --warmup 0 --runs 1
    run_java --demo --engine duckdb --dataset ppd --case ppd_sales_by_year --file "${PPD_PARQUET}" --threads 8 --warmup 0 --runs 1
    ;;
  05-copy-to-parquet)
    require_env "DUCKDB_DEMO_PPD_CSV"
    OUT="${DUCKDB_DEMO_PPD_PARQUET_SMALL:-${ROOT_DIR}/tmp/demo-output.parquet}"
    run_java --engine duckdb --dataset ppd --file "${DUCKDB_DEMO_PPD_CSV}" --to-parquet "${OUT}" --threads 8
    run_java --demo --engine duckdb --dataset ppd --case ppd_avg_by_district --file "${OUT}" --threads 8 --warmup 0 --runs 1
    ;;
  *)
    echo "Unknown alias: ${alias_name}" >&2
    exit 1
    ;;
esac
